## 第 id 关的奖牌数（存档键 "1"/"2"/"3"）
static func medal_count(save: Dictionary, id: int) -> int:
	return save["medals"].get(str(id), []).size()


## 解锁规则（设计 2.8）：关 2 需关 1 奖牌 ≥2；关 3 需关 1+2 累计 ≥4
static func is_unlocked(save: Dictionary, id: int) -> bool:
	if id <= 1:
		return true
	if id == 2:
		return medal_count(save, 1) >= 2
	return medal_count(save, 1) + medal_count(save, 2) >= 4
